{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psych-sandbox.local/schemas/evidence-graph.v1.schema.json",
  "title": "Sandbox Evidence Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSnapshotId", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": "sandbox.evidence-graph.v1" },
    "sourceSnapshotId": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "kind", "label", "value", "fidelity", "sourcePaths", "objectIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["fact", "feature"] },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/jsonValue" },
        "fidelity": { "enum": ["deterministic", "weak"] },
        "sourcePaths": { "type": "array", "items": { "type": "string" } },
        "objectIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "fromNodeId", "toNodeId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "derived_from" },
        "fromNodeId": { "type": "string", "minLength": 1 },
        "toNodeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
