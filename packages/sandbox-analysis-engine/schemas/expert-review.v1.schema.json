{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psych-sandbox.local/schemas/expert-review.v1.schema.json",
  "title": "Sandbox Expert Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "analysisId",
    "analysisHash",
    "promptContextHash",
    "reviewerPseudonym",
    "rubricVersion",
    "scores",
    "weightedAverage",
    "automaticRejectConditions",
    "status",
    "summary",
    "revisions",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "sandbox.expert-review.v1" },
    "reviewId": { "type": "string", "minLength": 1 },
    "analysisId": { "type": "string", "minLength": 1 },
    "analysisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promptContextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerPseudonym": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^@]+$" },
    "rubricVersion": { "const": "sandbox.analysis.expert-rubric.v1" },
    "scores": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimensionId", "score", "comment"],
        "properties": {
          "dimensionId": { "type": "string", "minLength": 1 },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string" }
        }
      }
    },
    "weightedAverage": { "type": "number", "minimum": 1, "maximum": 5 },
    "automaticRejectConditions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "status": { "enum": ["accepted", "rejected", "needs_revision"] },
    "summary": { "type": "string" },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["replace", "remove", "add"] },
          "previousValue": true,
          "proposedValue": true,
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
