{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psych-sandbox.local/schemas/sandbox-hypothesis-draft.v1.schema.json",
  "title": "Sandbox Hypothesis Draft V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hypotheses", "interviewQuestions", "warnings"],
  "properties": {
    "schemaVersion": { "const": "sandbox.hypothesis-draft.v1" },
    "hypotheses": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "interviewQuestions": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/question" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "confidence",
        "confidenceLevel",
        "supportingEvidenceIds",
        "contradictingEvidenceIds",
        "alternativeExplanations",
        "explanation",
        "questionsToVerify",
        "interpretiveLimit"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidenceLevel": { "enum": ["low", "medium", "high"] },
        "supportingEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contradictingEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "alternativeExplanations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "explanation": { "type": "string", "minLength": 1 },
        "questionsToVerify": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "interpretiveLimit": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "intent", "leading", "evidenceIds", "hypothesisIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "leading": { "const": false },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "hypothesisIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
