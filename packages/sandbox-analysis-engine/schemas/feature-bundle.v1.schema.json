{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psych-sandbox.local/schemas/feature-bundle.v1.schema.json",
  "title": "Sandbox Deterministic Feature Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSnapshotId", "sourceSceneSchemaVersion", "algorithmVersion", "algorithmConfig", "processEvidence", "features", "evidenceGraph", "warnings"],
  "properties": {
    "schemaVersion": { "const": "sandbox.feature-bundle.v1" },
    "sourceSnapshotId": { "type": "string", "minLength": 1 },
    "sourceSceneSchemaVersion": { "const": "sandbox.reconstructed-scene.v1" },
    "algorithmVersion": { "const": "sandbox.feature-algorithm.v1" },
    "algorithmConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precisionDigits", "nearDistanceThreshold", "middleDistanceThreshold", "localNeighborThreshold", "visualSalienceWeights"],
      "properties": {
        "precisionDigits": { "type": "integer", "minimum": 0 },
        "nearDistanceThreshold": { "type": "number", "minimum": 0 },
        "middleDistanceThreshold": { "type": "number", "minimum": 0 },
        "localNeighborThreshold": { "type": "number", "minimum": 0 },
        "visualSalienceWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectedArea", "centerProximity", "scale"],
          "properties": {
            "projectedArea": { "type": "number", "minimum": 0, "maximum": 1 },
            "centerProximity": { "type": "number", "minimum": 0, "maximum": 1 },
            "scale": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "processEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity", "availableSignals", "unavailableSignals"],
      "properties": {
        "fidelity": { "const": "weak" },
        "availableSignals": { "const": ["createdOrder"] },
        "unavailableSignals": { "const": ["moveHistory", "deletionHistory", "dwellTime", "hesitation", "undoRedo"] }
      }
    },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "evidenceGraph": { "$ref": "./evidence-graph.v1.schema.json" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "kind", "label", "value", "fidelity", "objectIds", "evidenceIds", "method", "interpretiveLimit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["scene", "object", "relation", "category", "risk", "process"] },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/jsonValue" },
        "unit": { "type": "string" },
        "fidelity": { "enum": ["deterministic", "weak"] },
        "objectIds": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 1 },
        "interpretiveLimit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
