{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psych-sandbox.local/schemas/data-revocation.v1.schema.json",
  "title": "Sandbox Data Revocation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revocationId", "snapshotHash", "removedCaseIds", "requestedByPseudonym", "reason", "revokedAt"],
  "properties": {
    "schemaVersion": { "const": "sandbox.data-revocation.v1" },
    "revocationId": { "type": "string", "minLength": 1 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "removedCaseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requestedByPseudonym": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reason": { "type": "string", "minLength": 1 },
    "revokedAt": { "type": "string", "format": "date-time" }
  }
}
