{
  "name": "@psych-sandbox/analysis-engine",
  "version": "0.7.0",
  "description": "Framework-independent contracts, validation, migration and analysis interfaces for digital psychological sandplay snapshots.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/current-sandbox-snapshot.v1": "./schemas/current-sandbox-snapshot.v1.schema.json",
    "./schemas/sandbox-analysis-result.v1": "./schemas/sandbox-analysis-result.v1.schema.json",
    "./schemas/expert-review.v1": "./schemas/expert-review.v1.schema.json",
    "./schemas/revised-analysis.v1": "./schemas/revised-analysis.v1.schema.json",
    "./schemas/review-adjudication.v1": "./schemas/review-adjudication.v1.schema.json",
    "./schemas/review-case-bundle.v1": "./schemas/review-case-bundle.v1.schema.json",
    "./schemas/evaluation-case.v1": "./schemas/evaluation-case.v1.schema.json",
    "./schemas/evaluation-dataset-manifest.v1": "./schemas/evaluation-dataset-manifest.v1.schema.json",
    "./schemas/data-revocation.v1": "./schemas/data-revocation.v1.schema.json",
    "./schemas/model-evaluation-run.v1": "./schemas/model-evaluation-run.v1.schema.json",
    "./schemas/benchmark-report.v1": "./schemas/benchmark-report.v1.schema.json",
    "./schemas/evaluation-job.v1": "./schemas/evaluation-job.v1.schema.json",
    "./schemas/evaluation-job-event.v1": "./schemas/evaluation-job-event.v1.schema.json",
    "./schemas/experiment-audit-bundle.v1": "./schemas/experiment-audit-bundle.v1.schema.json",
    "./schemas/reconstructed-scene.v1": "./schemas/reconstructed-scene.v1.schema.json",
    "./schemas/evidence-graph.v1": "./schemas/evidence-graph.v1.schema.json",
    "./schemas/feature-bundle.v1": "./schemas/feature-bundle.v1.schema.json",
    "./schemas/sandbox-hypothesis-draft.v1": "./schemas/sandbox-hypothesis-draft.v1.schema.json",
    "./schemas/safety-evaluation.v1": "./schemas/safety-evaluation.v1.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:features": "npm run build && node --test tests/deterministic-features.test.mjs",
    "test:hypotheses": "npm run build && node --test tests/hypothesis-analysis.test.mjs",
    "test:safety": "npm run build && node --test tests/safety-policy.test.mjs",
    "test:review": "npm run build && node --test tests/expert-review-workflow.test.mjs",
    "test:dataset": "npm run build && node --test tests/evaluation-dataset.test.mjs",
    "test:runtime": "npm run build && node --test tests/evaluation-runtime.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true
}
