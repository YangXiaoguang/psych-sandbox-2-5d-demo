{
  "name": "psych-sandbox-2-5d-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:analysis-engine && tsc -b && vite build",
    "build:analysis-engine": "tsc -p packages/sandbox-analysis-engine/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "api:contract": "node scripts/export-api-contract.mjs",
    "qa:acceptance": "npm run build && npm run qa:analysis-spec && npm run qa:analysis-engine && npm run qa:analysis-features && npm run qa:analysis-hypotheses && npm run qa:analysis-safety && npm run qa:snapshot-contract && npm run qa:api-contract && npm run qa:api-client && npm run qa:mock-api && npm run qa:repository && npm run qa:toy-assets && npm run qa:stage-v2 && npm run qa:ui-shell && npm run qa:visual-baseline && npm run qa:visual-report",
    "qa:api-contract": "node scripts/export-api-contract.mjs",
    "qa:api-client": "node scripts/qa-api-client.mjs",
    "qa:analysis-spec": "node scripts/qa-sandbox-analysis-spec.mjs",
    "qa:analysis-engine": "npm run build:analysis-engine && node scripts/qa-sandbox-analysis-engine.mjs",
    "qa:analysis-features": "npm --prefix packages/sandbox-analysis-engine run test:features",
    "qa:analysis-hypotheses": "npm --prefix packages/sandbox-analysis-engine run test:hypotheses",
    "qa:analysis-safety": "npm --prefix packages/sandbox-analysis-engine run test:safety",
    "qa:mock-api": "node scripts/qa-mock-api-behavior.mjs",
    "qa:repository": "node scripts/qa-repository-adapters.mjs",
    "qa:snapshot-contract": "node scripts/qa-current-snapshot-contract.mjs",
    "qa:toy-assets": "node scripts/qa-toy-asset-render.mjs",
    "qa:stage-v2": "node scripts/qa-stage-v2.mjs",
    "qa:ui-shell": "node scripts/qa-ui-shell.mjs",
    "qa:visual-baseline": "node scripts/capture-visual-baseline.mjs",
    "qa:visual-report": "node scripts/generate-visual-review.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "konva": "^9.3.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
